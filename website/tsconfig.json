{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../shared/src/*"],
      "@mobile/*": ["../mobile-website/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "../shared/src", "../mobile-website/src", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
